# QuickDrop environment configuration
# Copy this file to `.env` and fill in the deployed KLAIM API URL.

# Base URL of the deployed KLAIM API (no trailing slash).
VITE_KLAIM_API_URL=https://klaim-api.example.com

# Demo user DID used when creating verification requests.
VITE_DEMO_DID=did:identipi:demo-user-001

# Verifier identifier for this relying application.
VITE_VERIFIER_ID=quickdrop-demo

# --- Demo / mock mode -------------------------------------------------------
# When "true", KLAIM responses are simulated locally (no network). Useful for
# previewing the full flow before the real backend URL is available.
# Leave unset or "false" to use the real VITE_KLAIM_API_URL.
# (If the API URL is left as a placeholder, mock mode turns on automatically.)
VITE_KLAIM_MOCK=false

# Which simulated ending to show in mock mode:
# verified | denied | credential_invalid | payment_failed
VITE_KLAIM_MOCK_OUTCOME=verified
