# Dependencies & build output (rebuilt inside the image)
node_modules
dist
dist-ssr

# Version control & CI
.git
.github
.gitignore

# Environment files — never bake secrets into the image.
# VITE_* values are passed via --build-arg at build time instead.
.env
.env.*
!.env.example

# Logs & caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.cache

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Deploy metadata not needed in the build context
vercel.json
README.md
